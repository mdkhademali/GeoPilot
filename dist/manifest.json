{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "GeoPilot — Your Geospatial Research Companion",
  "short_name": "GeoPilot",
  "version": "1.0.0",
  "description": "Local-first geospatial research tools: coordinates, spectral indices, GeoJSON, citations, notes and workflow guides.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "GeoPilot", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+G" } } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.crossref.org" }
}
